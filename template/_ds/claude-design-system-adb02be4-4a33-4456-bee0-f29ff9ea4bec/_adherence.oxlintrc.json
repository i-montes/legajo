{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/badges/**",
              "components/buttons/**",
              "components/cards/**",
              "components/inputs/**",
              "components/navigation/**",
              "components/sections/**",
              "components/tabs/**",
              "ui_kits/marketing-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Inter|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Inter, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, variant."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:neutral|coral)$/]",
        "message": "<Badge> variant must be one of 'neutral' | 'coral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|onClick|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, onClick, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|secondary-on-dark|text-link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'secondary-on-dark' | 'text-link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CalloutCardCoral'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<CalloutCardCoral> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryTab'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|active|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryTab> doesn't accept that prop. Declared props: children, active, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeWindowCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:filename|lines|key|ref|className|style|children)$/]",
        "message": "<CodeWindowCard> doesn't accept that prop. Declared props: filename, lines."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConnectorTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|icon|key|ref|className|style|children)$/]",
        "message": "<ConnectorTile> doesn't accept that prop. Declared props: name, description, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='CookieConsentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:onAccept|onDismiss|key|ref|className|style|children)$/]",
        "message": "<CookieConsentCard> doesn't accept that prop. Declared props: onAccept, onDismiss."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|title|subtitle|key|ref|className|style|children)$/]",
        "message": "<CtaBand> doesn't accept that prop. Declared props: variant, title, subtitle."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaBand'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:coral|dark)$/]",
        "message": "<CtaBand> variant must be one of 'coral' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|icon|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: title, body, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: columns."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroBand'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|key|ref|className|style|children)$/]",
        "message": "<HeroBand> doesn't accept that prop. Declared props: title, subtitle, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroIllustrationCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<HeroIllustrationCard> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: children, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ModelComparisonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|key|ref|className|style|children)$/]",
        "message": "<ModelComparisonCard> doesn't accept that prop. Declared props: name, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='PricingTierCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:tier|price|period|features|featured|key|ref|className|style|children)$/]",
        "message": "<PricingTierCard> doesn't accept that prop. Declared props: tier, price, period, features, featured."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductMockupCardDark'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|key|ref|className|style|children)$/]",
        "message": "<ProductMockupCardDark> doesn't accept that prop. Declared props: title, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: placeholder, value, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: links."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
