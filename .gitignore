# Entorno y credenciales
.env
.env.*
!.env.example

# La clave con la que se firman las actualizaciones. Vive en ~/.tauri y en los
# secretos del repositorio en GitHub, nunca aqui: quien la tenga puede publicar
# una actualizacion que todas las instalaciones aceptaran como legitima.
*.key
!*.key.pub

# Rust / Tauri
# target/ está en la raíz porque el proyecto es un workspace de Cargo.
target/
src-tauri/target/
src-tauri/gen/

# Node
node_modules/
dist/
.vite/

# Datos locales
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/
exports/

# Sistema
.DS_Store
Thumbs.db

# Sidecar de Python
.venv/
sidecar/__pycache__/
sidecar/dist/
sidecar/build/
# Corridas del banco de modelos: medio mega de JSON cada una, y se regeneran
# con `sidecar/banco.py`. Los veredictos del juez sí se guardan: son pequeños y
# docs/pipeline.md remite a ellos.
sidecar/banco/*.json
!sidecar/banco/juez-*.json

# Metadatos que WSL arrastra de Windows
*:Zone.Identifier

# Modelo afinado instalado para desarrollo (1,2 GB): se instala con
# sidecar/instalar_modelo.py --destino sidecar/modelos
sidecar/modelos/
# Pesos y puntos de control de las corridas de entrenamiento (1,2 GB cada uno);
# los RESULTADOS.md, informes y conjuntos exportados sí se guardan.
sidecar/entrenamiento/**/lr*/
sidecar/entrenamiento/**/curriculo-*/
sidecar/entrenamiento/**/checkpoint-*/
# Conjuntos exportados por exportar_patron.py (texto del archivo, 58 MB): se regeneran
sidecar/entrenamiento/*/train*.jsonl
sidecar/entrenamiento/*/val*.jsonl
sidecar/entrenamiento/*/apartado*.jsonl
sidecar/entrenamiento/*/prueba*.jsonl
sidecar/entrenamiento/**/final/
sidecar/entrenamiento/**/corrida/
