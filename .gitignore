# Entorno y credenciales
.env
.env.*
!.env.example

# La clave con la que se firman las actualizaciones. Vive en ~/.tauri y en los
# secretos del repositorio en GitHub, nunca aqui: quien la tenga puede publicar
# una actualizacion que todas las instalaciones aceptaran como legitima.
*.key
!*.key.pub

# Rust / Tauri
# target/ está en la raíz porque el proyecto es un workspace de Cargo.
target/
src-tauri/target/
src-tauri/gen/

# Node
node_modules/
dist/
.vite/

# Datos locales
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
data/
exports/

# Sistema
.DS_Store
Thumbs.db

# Sidecar de Python
.venv/
sidecar/__pycache__/
sidecar/dist/
sidecar/build/
# Corridas del banco de modelos: medio mega de JSON cada una, y se regeneran
# con `sidecar/banco.py`. Los veredictos del juez sí se guardan: son pequeños y
# docs/pipeline.md remite a ellos.
sidecar/banco/*.json
!sidecar/banco/juez-*.json

# Metadatos que WSL arrastra de Windows
*:Zone.Identifier
