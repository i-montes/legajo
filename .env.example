# Copia este archivo a .env y rellena con tu propia app Native de WordPress.com.
# Regístrala en https://developer.wordpress.com/apps/ con:
#   Type          = Native
#   Redirect URLs = http://127.0.0.1:8765/callback
#                   http://localhost:8765/callback
# Es OPCIONAL: sin esto, Legajo funciona con lectura anónima y Application Passwords.
WPCOM_CLIENT_ID=
WPCOM_CLIENT_SECRET=
WPCOM_REDIRECT_URI=http://127.0.0.1:8765/callback
