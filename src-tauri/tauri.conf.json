{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Legajo",
  "version": "0.1.0",
  "identifier": "com.legajo.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Legajo",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "../sidecar/legajo_ner.py": "sidecar/legajo_ner.py",
      "../sidecar/preparar.py": "sidecar/preparar.py",
      "../sidecar/requirements.txt": "sidecar/requirements.txt"
    },
    "shortDescription": "Radiografía y muestreo del archivo de un sitio en WordPress",
    "longDescription": "Legajo conecta el archivo de cualquier sitio en WordPress, lo lee entero, y extrae entidades y relaciones con corrección humana por delante. Todo el procesamiento ocurre en el computador.",
    "category": "Utility",
    "copyright": "La Silla Vacía",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/i-montes/legajo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBN0ZBQTVEOTI3OTcyNEEKUldSS2NubVNYYXAvK255QkllbmdLNFNVK2hWVkZXZnVIOFlSdWgvejlHUjFYaVFuUU84L3B6Zm0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
